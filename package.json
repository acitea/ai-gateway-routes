{
  "name": "ai-gateway-routes",
  "version": "0.2.0",
  "description": "YAML authoring, validation, visualization, and Terraform/API compilation for Cloudflare AI Gateway dynamic routes.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acitea/ai-gateway-routes.git"
  },
  "bugs": {
    "url": "https://github.com/acitea/ai-gateway-routes/issues"
  },
  "homepage": "https://acitea.github.io/ai-gateway-routes/",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "ai-gateway-routes": "dist/cli.js",
    "agr": "dist/cli.js"
  },
  "files": [
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "docs/typescript.md",
    "docs/typescript-compatibility.md",
    "dist",
    "examples",
    "schemas",
    "SECURITY.md",
    "scripts/fix-dts-imports.mjs",
    "scripts/update-cloudflare-schema.mjs",
    "README.md"
  ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json && node scripts/fix-dts-imports.mjs && bun build ./src/index.ts ./src/cli.ts --outdir dist --target node --format esm --sourcemap=external --external zod --external yaml",
    "ci": "npm run typecheck && npm test && npm run build && npm run test:types && npm run pack:dry-run",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "pack:dry-run": "npm pack --dry-run --cache /tmp/ai-gateway-routes-npm-cache",
    "prepublishOnly": "npm run ci",
    "schema:update": "node scripts/update-cloudflare-schema.mjs",
    "test": "bun test",
    "test:types": "tsc -p test/typescript-nodenext/tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "cloudflare",
    "ai-gateway",
    "cloudflare-ai-gateway",
    "terraform",
    "routes",
    "yaml",
    "dsl",
    "typescript"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "yaml": "^2.8.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "ajv": "^8.20.0",
    "typescript": "^5.5.4"
  }
}
